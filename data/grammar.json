  "articles": [
    {
      "emoji": "🔤",
      "title": "Two little words",
      "lines": [
        "English puts a tiny word in front of most things.",
        "a  ·  an  ·  the"
      ],
      "say": "a. an. the."
    },
    {
      "emoji": "1️⃣",
      "title": "a = one of them",
      "lines": [
        "\"I see a dog.\"",
        "Any dog. You don't know which one yet — it's the first time I've said it."
      ],
      "say": "I see a dog."
    },
    {
      "emoji": "🍎",
      "title": "an before a vowel sound",
      "lines": [
        "an apple · an egg · an umbrella",
        "Say \"a apple\" out loud — your mouth trips over it. That's the whole reason for an."
      ],
      "say": "an apple. an egg. an umbrella."
    },
    {
      "emoji": "🤝",
      "title": "the = we both know which one",
      "lines": [
        "\"The dog is barking.\"",
        "Not any dog — our dog. When I say the, I'm telling you: you already know the one I mean."
      ],
      "say": "The dog is barking."
    },
    {
      "emoji": "☀️",
      "title": "the = there is only one",
      "lines": [
        "the sun · the moon · the sky",
        "There is only one of each in the whole world, so there is nothing to pick between."
      ],
      "say": "the sun. the moon. the sky."
    },
    {
      "emoji": "👧",
      "title": "\"the girl\"",
      "lines": [
        "\"A girl is here\" — a new girl, you don't know her yet.",
        "\"The girl is here\" — you know which girl. I'm pointing you at one we've already talked about."
      ],
      "say": "A girl is here. The girl is here."
    },
    {
      "emoji": "🐶",
      "title": "More than one → add s",
      "lines": [
        "one dog → a dog",
        "two dogs → dogs  (never \"a dogs\")"
      ],
      "say": "a dog. two dogs."
    },
    {
      "emoji": "🥛",
      "title": "Some things take no word at all",
      "lines": [
        "milk · water · rice",
        "You can't count them one, two, three — so they go bare: \"I want milk.\""
      ],
      "say": "I want milk."
    }
  ]
